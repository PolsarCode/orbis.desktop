{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orbis",
  "version": "0.1.0",
  "identifier": "com.polsarcode.orbis",
  "build": {
    "frontendDist": "https://orbis.polsar.studio",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Orbis",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5RTA2NDc0NzRCOEY3MjkKUldRcDk3aDBkR1RnaWIrakF1bGo4ZHZ2clYvTEJxaWdrWisxdHl0QTZZcHdrNUFTbVJHMHVRSUoK",
      "endpoints": [
        "https://github.com/PolsarCode/orbis.desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
