{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notifications",
  "description": "Lets the Orbis web app show native notifications, set the Dock badge, ask for attention, start on login, and drag the window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000/*",
      "https://orbis.polsar.studio/*"
    ]
  },
  "permissions": [
    "notification:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-badge-count",
    "core:window:allow-request-user-attention",
    "autostart:default"
  ]
}
