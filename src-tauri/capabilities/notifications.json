{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notifications",
  "description": "Lets the Orbis web app show native notifications and drag the window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:3000/*",
      "https://orbis.polsar.studio/*"
    ]
  },
  "permissions": [
    "notification:default",
    "core:window:allow-start-dragging"
  ]
}
